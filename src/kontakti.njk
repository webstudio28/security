---
layout: base.njk
permalink: /kontakti/
title: Контакти
description: Свържете се с Лидер Секюрити Груп - работим на територията на цяла България. Телефон 0876 50 99 89, имейл leadergrup@abv.bg, обаждания денонощно.
---
{% from "macros/page-banner.njk" import pageBanner %}
{% from "macros/breadcrumbs.njk" import breadcrumbs %}

{% call pageBanner() %}
  <div class="eyebrow text-brand before:bg-brand">Контакти</div>
  <h1 class="mt-3 max-w-3xl font-display text-[clamp(2.5rem,5vw,3.75rem)] font-black leading-none">Връзка с нас</h1>
  <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/70">Обадете се денонощно, оставете запитване или ни пишете във Viber и WhatsApp.</p>
{% endcall %}

{{ breadcrumbs([
  { label: "Начало", url: "/" },
  { label: "Контакти" }
]) }}

<section class="section-pad bg-brand-soft">
  <div class="container-site grid gap-8 lg:grid-cols-2">
    <div class="space-y-4 reveal">
      {% set rows = [
        { "label": "Телефон", "value": site.contact.phone, "href": site.contact.phoneHref },
        { "label": "Имейл", "value": site.contact.email, "href": "mailto:" + site.contact.email },
        { "label": "Обаждания", "value": site.contact.hours }
      ] %}
      {% for r in rows %}
        <div class="rounded-xl border border-white/10 bg-brand-mist p-5">
          <div class="font-display text-xs font-bold uppercase tracking-[0.12em] text-brand">{{ r.label }}</div>
          {% if r.href %}
            <a class="mt-2 block font-display text-xl font-extrabold text-ink no-underline hover:text-brand" href="{{ r.href }}">{{ r.value }}</a>
          {% else %}
            <div class="mt-2 font-display text-xl font-extrabold text-ink">{{ r.value }}</div>
          {% endif %}
        </div>
      {% endfor %}
      {% if site.contact.address %}
        <div class="rounded-xl border border-white/10 bg-brand-mist p-5">
          <div class="font-display text-xs font-bold uppercase tracking-[0.12em] text-brand">Адрес</div>
          <div class="mt-2 font-display text-xl font-extrabold text-ink">{{ site.contact.address }}</div>
        </div>
      {% endif %}
      <div class="flex flex-wrap gap-3 pt-2">
        <a class="inline-flex items-center gap-2.5 rounded-xl border border-white/10 bg-brand-mist px-5 py-4 font-display text-lg font-extrabold text-ink no-underline transition hover:border-brand/60" href="{{ site.contact.facebook }}" target="_blank" rel="noopener noreferrer">
          {% include "icons/facebook.njk" %}
          <span>{{ site.brand.name }}</span>
        </a>
        {% if site.contact.viber and site.contact.viber != "#" %}
          <a class="inline-flex items-center gap-2.5 rounded-xl border border-white/10 bg-brand-mist px-5 py-4 font-display text-lg font-extrabold text-ink no-underline transition hover:border-brand/60" href="{{ site.contact.viber }}">
            {% include "icons/viber.njk" %}
            <span>Viber</span>
          </a>
        {% endif %}
        {% if site.contact.whatsapp and site.contact.whatsapp != "#" %}
          <a class="inline-flex items-center gap-2.5 rounded-xl border border-white/10 bg-brand-mist px-5 py-4 font-display text-lg font-extrabold text-ink no-underline transition hover:border-brand/60" href="{{ site.contact.whatsapp }}" target="_blank" rel="noopener noreferrer">
            {% include "icons/whatsapp.njk" %}
            <span>WhatsApp</span>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="card reveal p-6 md:p-8">
      <div class="eyebrow">Запитване</div>
      <h2 class="mt-2 font-display text-3xl font-extrabold">Заявете охрана</h2>
      <p class="mt-2 text-ink-muted">Попълнете формата и ще се свържем с вас.</p>
      <form class="mt-6 grid gap-3.5" onsubmit="event.preventDefault(); this.querySelector('[data-ok]').classList.remove('hidden');">
        <input class="rounded-lg border border-white/10 bg-brand-mist px-3.5 py-3 text-ink outline-none placeholder:text-ink-faint focus:border-brand focus:ring-4 focus:ring-brand/10" placeholder="Име" required />
        <input class="rounded-lg border border-white/10 bg-brand-mist px-3.5 py-3 text-ink outline-none placeholder:text-ink-faint focus:border-brand focus:ring-4 focus:ring-brand/10" placeholder="Телефон" required />
        <textarea class="rounded-lg border border-white/10 bg-brand-mist px-3.5 py-3 text-ink outline-none placeholder:text-ink-faint focus:border-brand focus:ring-4 focus:ring-brand/10" rows="4" placeholder="Кратко описание на обекта и нужната охрана"></textarea>
        <button class="btn btn-primary" type="submit">Изпрати</button>
        <p class="hidden text-sm font-medium text-brand" data-ok>Благодарим. За директен контакт: {{ site.contact.email }} или {{ site.contact.phone }}.</p>
      </form>
    </div>
  </div>
</section>
