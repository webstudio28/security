<dialog id="companyPhotoViewer" class="company-photo-viewer" aria-label="Галерия със снимки" aria-describedby="companyPhotoCaption">
  <div class="company-photo-toolbar">
    <span id="companyPhotoCount" aria-live="polite"></span>
    <button class="company-photo-control" type="button" data-gallery-close aria-label="Затвори снимката">✕</button>
  </div>
  <img id="companyPhotoImage" class="company-photo-image" alt="" />
  <div class="company-photo-toolbar">
    <button class="company-photo-control" type="button" data-gallery-previous aria-label="Предишна снимка">←</button>
    <p id="companyPhotoCaption" class="text-center text-ink" aria-live="polite"></p>
    <button class="company-photo-control" type="button" data-gallery-next aria-label="Следваща снимка">→</button>
  </div>
</dialog>
