<section class="relative flex h-svh min-h-0 items-center overflow-hidden text-white">
  <div class="absolute inset-0 scale-[1.02] bg-cover bg-center" style="background-image:url('{{ '/assets/images/heroes/private-security-bulgaria.webp' | url }}');background-position:90% center" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-brand-deeper/95 via-brand-deeper/80 to-brand-deeper/45" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-brand-deeper to-transparent" aria-hidden="true"></div>

  <div class="container-site relative z-10 py-24 md:pb-28 md:pt-40">
    <h1 class="mb-5 max-w-4xl font-display text-[clamp(2.5rem,9vw,6.5rem)] font-black leading-[0.91] tracking-tight md:mb-6">
      {{ home.hero.title }}
      <span class="mt-1 block text-brand">{{ home.hero.titleAccent }}</span>
    </h1>
    <p class="mb-6 max-w-xl text-lg leading-relaxed text-white/80 md:mb-8 md:text-xl">{{ home.hero.copy }}</p>
    <div class="flex flex-wrap gap-3.5">
      <button class="btn btn-primary open-inquiry" type="button">Заяви охрана</button>
      <a class="btn btn-light" href="{{ '/uslugi/' | url }}">Разгледай услугите</a>
    </div>
  </div>
</section>
