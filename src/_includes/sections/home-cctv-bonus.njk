<section class="section-pad bg-brand-mist" aria-labelledby="home-cctv-bonus-title">
  <div class="container-site grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
    <div class="reveal order-2 lg:order-1">
      <div class="eyebrow">{{ home.cctvBonus.eyebrow }}</div>
      <h2 class="section-title" id="home-cctv-bonus-title">
        {{ home.cctvBonus.title }}
        <span class="text-brand">{{ home.cctvBonus.titleAccent }}</span>
      </h2>
      <p class="mt-5 max-w-xl text-[17px] leading-relaxed text-ink-muted">{{ home.cctvBonus.text }}</p>
      <a class="btn btn-primary mt-8" href="{{ home.cctvBonus.url | url }}">
        {{ home.cctvBonus.cta }}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <div class="reveal order-1 overflow-hidden rounded-[13px] border border-white/[0.06] shadow-lift lg:order-2">
      <img
        class="aspect-[4/3] w-full object-cover"
        src="{{ home.cctvBonus.image | url }}"
        alt="{{ home.cctvBonus.imageAlt }}"
        width="1448"
        height="1086"
        loading="lazy"
      />
    </div>
  </div>
</section>
