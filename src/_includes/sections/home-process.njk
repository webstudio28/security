<section class="relative overflow-x-clip section-pad text-white">
  <div class="absolute inset-0 bg-brand-deeper" aria-hidden="true"></div>
  <div
    class="absolute inset-0 scale-[1.02] bg-cover bg-center opacity-[0.06]"
    style="background-image:url('{{ '/assets/images/sections/security-monitoring-desk.webp' | url }}')"
    aria-hidden="true"
  ></div>
  <div class="absolute inset-0 bg-gradient-to-b from-brand-deeper/40 via-transparent to-brand-deeper/80" aria-hidden="true"></div>

  <div class="container-site relative z-10">
    <div class="reveal">
      <div class="eyebrow text-brand before:bg-brand">Как работим</div>
      <h2 class="section-title text-ink">От запитването до активна охрана</h2>
      <p class="section-copy text-white/70">Ясен процес, точна комуникация и професионално изпълнение.</p>
    </div>
  </div>

  <div class="container-site relative z-10 mt-14 max-md:contents">
    <div class="h-scroll mt-14 reveal md:mt-0 md:grid md:grid-cols-2 md:gap-4 lg:grid-cols-4">
      {% for step in home.process %}
        <article class="relative rounded-xl border border-white/[0.06] bg-[#25292e] p-5 shadow-[0_6px_18px_rgba(0,0,0,0.28)]">
          <span class="mb-3 grid h-11 w-11 place-items-center rounded-full border border-brand/50 bg-brand/10 font-display text-[15px] font-extrabold text-brand">0{{ loop.index }}</span>
          <h3 class="mb-1.5 font-display text-lg font-extrabold leading-snug">{{ step.title }}</h3>
          <p class="m-0 text-sm leading-relaxed text-ink-muted">{{ step.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>

  <div class="container-site relative z-10 mt-8 reveal">
    <button class="btn btn-primary open-inquiry" type="button">Заяви охрана</button>
  </div>
</section>
