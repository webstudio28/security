<section class="section-pad overflow-x-clip bg-brand-mist">
  <div class="container-site">
    <div class="mb-8 reveal md:mb-12">
      <div class="eyebrow">Защо да изберете нас</div>
      <h2 class="section-title">Сигурността е в детайлите</h2>
      <p class="section-copy">От оценката на риска до ежедневния контрол — поемаме отговорност за всяка стъпка.</p>
    </div>
  </div>

  <div class="container-site max-md:contents">
    <div class="h-scroll reveal md:grid md:grid-cols-2 md:gap-4 lg:grid-cols-4">
      {% for item in home.why %}
        <article class="relative overflow-hidden rounded-xl border border-white/[0.06] bg-[#2f3339] p-5 shadow-[0_6px_18px_rgba(0,0,0,0.28)] transition hover:-translate-y-1 hover:border-white/10 md:p-6">
          <span class="absolute right-3 top-1 font-display text-5xl font-black text-brand/15">0{{ loop.index }}</span>
          <span class="relative mb-4 grid h-12 w-12 place-items-center rounded-xl bg-brand/15 text-brand" aria-hidden="true">
            {% if item.icon == "approach" %}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M11.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM20 8v6M23 11h-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% elif item.icon == "quality" %}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="m12 3 2.1 4.3 4.7.7-3.4 3.3.8 4.7L12 13.8 7.8 16l.8-4.7L5.2 8l4.7-.7L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% elif item.icon == "install" %}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5 2.5-2.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% else %}
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z M3.3 7 12 12l8.7-5M12 22V12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% endif %}
          </span>
          <h3 class="relative mb-2 font-display text-lg font-extrabold md:text-xl">{{ item.title }}</h3>
          <p class="relative m-0 text-sm leading-relaxed text-ink-muted">{{ item.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
