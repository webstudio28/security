<footer class="bg-brand-deeper text-white border-t border-white/10">
  <div class="container-site">
    <div class="grid gap-10 border-b border-white/10 py-14 text-center md:grid-cols-2 md:text-left lg:grid-cols-4">
      <div class="flex flex-col items-center lg:col-span-1 md:items-start">
        <a class="mb-4 inline-flex items-center no-underline" href="{{ '/' | url }}" aria-label="{{ site.brand.name }} – начало">
          <img
            class="h-24 w-auto"
            src="{{ '/assets/images/logo.png' | url }}"
            alt="{{ site.brand.name }}"
            width="774"
            height="655"
            decoding="async"
          />
        </a>
        <p class="mx-auto max-w-xs text-[15px] leading-relaxed text-white/50 md:mx-0">{{ site.seo.defaultDescription }}</p>
      </div>

      <div class="flex flex-col items-center md:items-start">
        <h3 class="mb-5 inline-block border-b-2 border-brand pb-2 font-display text-[15px] font-extrabold uppercase tracking-[0.12em] text-white/90">Услуги</h3>
        <ul class="flex flex-col items-center gap-2.5 md:items-start">
          {% for s in services | withoutMenuGroups %}
            <li><a class="text-[15px] text-white/50 no-underline transition hover:text-brand" href="{{ ('/uslugi/' + s.slug + '/') | url }}">{{ s.title }}</a></li>
          {% endfor %}
          <li><a class="text-[15px] text-white/50 no-underline transition hover:text-brand" href="{{ '/uslugi/' | url }}">Всички услуги</a></li>
        </ul>
      </div>

      <div class="flex flex-col items-center md:items-start">
        <h3 class="mb-5 inline-block border-b-2 border-brand pb-2 font-display text-[15px] font-extrabold uppercase tracking-[0.12em] text-white/90">Компания</h3>
        <ul class="flex flex-col items-center gap-2.5 md:items-start">
          <li><a class="text-[15px] text-white/50 no-underline transition hover:text-brand" href="{{ '/za-nas/' | url }}">За нас</a></li>
          <li><a class="text-[15px] text-white/50 no-underline transition hover:text-brand" href="{{ '/uslugi/' | url }}">Услуги</a></li>
          <li><a class="text-[15px] text-white/50 no-underline transition hover:text-brand" href="{{ '/uslugi/videonablyudenie/' | url }}">Видеонаблюдение</a></li>
          <li><a class="text-[15px] text-white/50 no-underline transition hover:text-brand" href="{{ '/kontakti/' | url }}">Контакти</a></li>
        </ul>
      </div>

      <div class="flex flex-col items-center md:items-start">
        <h3 class="mb-5 inline-block border-b-2 border-brand pb-2 font-display text-[15px] font-extrabold uppercase tracking-[0.12em] text-white/90">Контакти</h3>
        <ul class="flex flex-col items-center gap-3 text-[15px] text-white/50 md:items-start">
          <li><a class="text-white/50 no-underline transition hover:text-brand" href="{{ site.contact.phoneHref }}">{{ site.contact.phone }}</a></li>
          <li><a class="text-white/50 no-underline transition hover:text-brand" href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></li>
          {% if site.contact.address %}
            <li>{{ site.contact.address }}</li>
          {% endif %}
          <li>{{ site.contact.hours }}</li>
        </ul>
        <div class="mt-4 flex flex-col items-center gap-3 md:items-start">
          {% if site.contact.facebook and site.contact.facebook != "#" %}
            <a class="inline-flex items-center gap-2.5 text-[15px] text-white/70 no-underline transition hover:text-white" href="{{ site.contact.facebook }}" target="_blank" rel="noopener noreferrer">
              {% include "icons/facebook.njk" %}
              <span>{{ site.brand.name }}</span>
            </a>
          {% endif %}
          {% if site.contact.viber and site.contact.viber != "#" %}
            <a class="inline-flex items-center gap-2.5 text-[15px] text-white/70 no-underline transition hover:text-white" href="{{ site.contact.viber }}">
              {% include "icons/viber.njk" %}
              <span>Viber</span>
            </a>
          {% endif %}
          {% if site.contact.whatsapp and site.contact.whatsapp != "#" %}
            <a class="inline-flex items-center gap-2.5 text-[15px] text-white/70 no-underline transition hover:text-white" href="{{ site.contact.whatsapp }}" target="_blank" rel="noopener noreferrer">
              {% include "icons/whatsapp.njk" %}
              <span>WhatsApp</span>
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 py-5 text-center text-[13px] text-white/30 md:flex-row md:text-left">
      <span>© {{ site.currentYear }} {{ site.brand.name }}. Всички права запазени.</span>
      <span>{{ site.brand.tagline }}</span>
    </div>
  </div>
</footer>
