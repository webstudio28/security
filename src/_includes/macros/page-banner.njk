{% macro pageBanner(containerClass="container-site") %}
<section class="page-banner relative overflow-hidden text-white">
  <div class="absolute inset-0 bg-gradient-to-br from-brand-deeper via-[#16191d] to-brand-mist" aria-hidden="true"></div>
  <div
    class="absolute inset-0 scale-[1.02] bg-cover bg-center opacity-15"
    style="background-image:url('{{ '/assets/images/pages-bg.png' | url }}')"
    aria-hidden="true"
  ></div>
  <div class="{{ containerClass }} relative z-10">
    {{ caller() }}
  </div>
</section>
{% endmacro %}
