<div class="pointer-events-none invisible fixed inset-0 z-[130] grid place-items-center overflow-x-hidden p-5" id="inquiryModal" aria-hidden="true">
  <div class="absolute inset-0 bg-black/75 opacity-0 backdrop-blur-sm transition" data-close-modal></div>
  <div class="relative max-h-[calc(100dvh-40px)] w-full min-w-0 max-w-[590px] translate-y-4 overflow-auto rounded-2xl border border-white/10 bg-brand-soft p-5 opacity-0 shadow-[0_30px_90px_rgba(0,0,0,0.5)] transition sm:p-8" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <button class="absolute right-4 top-4 grid h-9 w-9 place-items-center rounded-lg bg-brand-mist text-ink" type="button" data-close-modal aria-label="Затвори">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none"><path d="m5 5 14 14M19 5 5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <div id="formContent">
      <div class="eyebrow">{{ inquiryEyebrow or 'Запитване за охрана' }}</div>
      <h2 id="modalTitle" class="mt-2 pr-10 font-display text-[2rem] font-extrabold leading-tight">Разкажете ни за вашия обект</h2>
      <p class="mt-2 text-ink-muted leading-relaxed">{{ inquiryDescription or 'Оставете контакт и ще се свържем с вас за предложение.' }}</p>
      <form id="inquiryForm" class="mt-6 min-w-0" action="{{ '/inquiry.php' | url }}" method="post" data-inquiry-form>
        <div class="grid min-w-0 gap-3.5 sm:grid-cols-2">
          <div class="flex min-w-0 flex-col gap-1.5">
            <label class="font-display text-[13px] font-bold uppercase tracking-wide" for="name">Име</label>
            <input class="w-full min-w-0 rounded-lg border border-white/10 bg-brand-mist px-3.5 py-3 text-[15px] text-ink outline-none placeholder:text-ink-faint focus:border-brand focus:ring-4 focus:ring-brand/10" id="name" name="name" required placeholder="Вашето име" />
          </div>
          <div class="flex min-w-0 flex-col gap-1.5">
            <label class="font-display text-[13px] font-bold uppercase tracking-wide" for="phone">Телефон</label>
            <input class="w-full min-w-0 rounded-lg border border-white/10 bg-brand-mist px-3.5 py-3 text-[15px] text-ink outline-none placeholder:text-ink-faint focus:border-brand focus:ring-4 focus:ring-brand/10" id="phone" name="phone" type="tel" required placeholder="08..." />
          </div>
          <div class="flex min-w-0 flex-col gap-1.5 sm:col-span-2">
            <label class="font-display text-[13px] font-bold uppercase tracking-wide" for="interest">Интересувам се от</label>
            <select class="w-full min-w-0 max-w-full rounded-lg border border-white/10 bg-brand-mist px-3.5 py-3 text-[15px] text-ink outline-none focus:border-brand focus:ring-4 focus:ring-brand/10" id="interest" name="interest">
              {% for s in services %}
                <option{% if inquiryService and s.title == inquiryService %} selected{% endif %}>{{ s.title }}</option>
              {% endfor %}
              <option>Друго</option>
            </select>
          </div>
          <div class="flex flex-col gap-1.5 sm:col-span-2">
            <label class="font-display text-[13px] font-bold uppercase tracking-wide" for="message">Кратко описание</label>
            <textarea class="rounded-lg border border-white/10 bg-brand-mist px-3.5 py-3 text-[15px] text-ink outline-none placeholder:text-ink-faint focus:border-brand focus:ring-4 focus:ring-brand/10" id="message" name="message" rows="3" placeholder="{{ inquiryPlaceholder or 'Тип обект, адрес, желан режим на охрана...' }}"></textarea>
          </div>
        </div>
        <div class="absolute h-px w-px overflow-hidden" aria-hidden="true">
          <label for="company">Компания</label>
          <input id="company" name="company" tabindex="-1" autocomplete="off" />
        </div>
        <button class="btn btn-primary mt-4 w-full" type="submit">Изпрати запитване</button>
        <p class="mt-3 hidden text-sm font-medium text-brand" data-error>Съобщението не беше изпратено. Обадете се на {{ site.contact.phone }} или пишете на {{ site.contact.email }}.</p>
      </form>
    </div>
    <div class="hidden py-8 text-center" id="formSuccess">
      <span class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-full bg-brand text-brand-deeper">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <h2 class="font-display text-3xl font-extrabold">Благодарим ви!</h2>
      <p class="mt-2 break-words text-ink-muted">За директен контакт пишете на {{ site.contact.email }} или се обадете на {{ site.contact.phone }} - {{ site.contact.hours | lower }}.</p>
    </div>
  </div>
</div>
