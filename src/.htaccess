# Block public access to form logs
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^private(/|$) - [F,L]
</IfModule>

# Longer cache for static assets (PageSpeed repeat visits)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# LiteSpeed keeps serving the previous HTML after FTP upload unless this cache is purged.
<IfModule LiteSpeed>
  RewriteEngine On
  RewriteRule ^__purge-lscache/?$ - [E=cache-purge:*,R=204,L]
  RewriteCond %{REQUEST_URI} !\.(css|js|mjs|webp|jpe?g|png|gif|svg|ico|woff2)$ [NC]
  RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>
